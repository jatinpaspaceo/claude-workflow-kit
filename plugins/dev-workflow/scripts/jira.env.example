# Jira REST credentials.  Copy to jira.env and `chmod 600` it.
# Used only to attach verification videos (step 13 of the workflow).
#
# JIRA_TOKEN: Atlassian account -> Security -> Create and manage API tokens
# NEVER commit this file, paste it into a skill, or put it in a Jira/MR comment.

JIRA_EMAIL=you@yourcompany.com
JIRA_TOKEN=your_atlassian_api_token_here
JIRA_BASE=https://your-site.atlassian.net
